{
  "$comment": "Hidden Token Gaming colour tokens. Dark is the designed default; light follows the OS setting. tokens.css carries the same values.",
  "dark": {
    "ground": "#070b17",
    "surface": "#0f1526",
    "line": "#1f2a44",
    "text": "#e8eef6",
    "muted": "#93a3bb",
    "accent": "#3ee07a",
    "on-accent": "#070b17",
    "link": "#3ee07a"
  },
  "light": {
    "ground": "#f2f5f9",
    "surface": "#ffffff",
    "line": "#d5dce6",
    "text": "#0b1222",
    "muted": "#4f5d74",
    "accent": "#3ee07a",
    "on-accent": "#0b1222",
    "link": "#0a7a3a"
  },
  "accents": {
    "green": { "value": "#3ee07a", "role": "lead: logo glow, calls to action, links, online", "light-text": "#0a7a3a" },
    "blue": { "value": "#3d8bff", "role": "new, secondary links", "light-text": "#1554d1" },
    "purple": { "value": "#8a63f5", "role": "events", "light-text": "#6a3fd8" }
  },
  "chrome": ["#ffffff", "#dfe6ee", "#7d8ca6", "#c9d3de", "#f4f7fb"],
  "glow": {
    "angle": "37 degrees from vertical, top left to bottom right (the chrome's angle)",
    "stops": [[0, "#3ee07a"], [0.12, "#3ee07a"], [0.25, "#3d8bff"], [0.75, "#3d8bff"], [0.88, "#8a63f5"], [1, "#8a63f5"]]
  },
  "font": {
    "wordmark": "Archivo 800, width 125",
    "subtitle": "Archivo 600, width 100, tracking 0.55em"
  }
}
